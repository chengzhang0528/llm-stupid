    { "id": "embedding", "lane": "inference", "col": 2, "type": "backend", "label": "Embedding 查表", "sublabel": "ID → 1024 维向量", "width": 150 },
    { "id": "prefill", "lane": "inference", "col": 3, "type": "backend", "label": "Prefill · 24 层", "sublabel": "所有提示位置；因果遮罩", "width": 170, "height": 100 },

    { "id": "token-phase", "label": "Prefill + Decode", "fromCol": 3, "toCol": 5, "variant": "emphasis" }
  ],
  "groups": [
    { "id": "repeated-decoder", "label": "24 层 Decode", "lane": "inference", "fromCol": 3, "toCol": 4, "variant": "emphasis" }
  ],
  "mainPath": ["request", "encode", "embedding", "prefill", "head", "sampler", "append", "output"],
  "nodes": [
    { "id": "request", "lane": "inference", "col": 0, "type": "external", "label": "对话消息", "sublabel": "system / user", "width": 150 },
